def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '17.2'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

node_require('react-native-permissions/scripts/setup.rb')

setup_permissions([
  'Microphone',
  'Bluetooth',
  'Notifications',
  'LocationWhenInUse'
])

target 'ZelloSdkExample' do
  use_frameworks!
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'ZelloSdkExampleTests' do
    inherit! :complete
    # Pods for testing
  end

  pre_install do |installer|
    installer.pod_targets.each do |pod|
      if pod.name.eql?('RNScreens')
        def pod.build_type
          Pod::BuildType.static_library
        end
      end
    end
  end

  # ZelloSDK's prebuilt binary was compiled against dependencies built with
  # library evolution, so it references resilient-only symbols (e.g. the
  # "enum case for PhoneNumberKit.PhoneNumberFormat.international" witness). Those
  # pods must be built with BUILD_LIBRARY_FOR_DISTRIBUTION=YES or the app crashes
  # in dyld at launch. We scope the flag to just those pods, because enabling it
  # globally breaks Swift module-interface verification for RN pods like RNScreens.
  # ZelloSDK's Swift dependencies (it references their resilient symbols).
  zello_resilient_pods = ['PhoneNumberKit', 'SnowplowTracker', 'CocoaLumberjack', 'PromisesSwift']

  post_install do |installer|
    installer.pods_project.targets.each do |target|
     target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "17.2"
      if zello_resilient_pods.include?(target.name)
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      end
     end
    end

    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end

target 'NotificationServiceExtension' do
  use_frameworks!

  # IMPORTANT: Make sure this is the same version as the podspec
  pod "ZelloSDK", "~> 2.0.0"

end
